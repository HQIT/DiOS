<configuration>
  <crm_config>
    <cluster_property_set id="dios-ha-policy">
      <nvpair id="dios-stonith" name="stonith-enabled" value="true"/>
      <nvpair id="dios-startup-fencing" name="startup-fencing" value="true"/>
      <nvpair id="dios-fence-action" name="stonith-action" value="off"/>
      <nvpair id="dios-quorum" name="no-quorum-policy" value="stop"/>
      <nvpair id="dios-symmetric" name="symmetric-cluster" value="false"/>
    </cluster_property_set>
    <cluster_property_set id="cib-bootstrap-options">
      <nvpair id="cib-bootstrap-options-have-watchdog" name="have-watchdog" value="false"/>
      <nvpair id="cib-bootstrap-options-dc-version" name="dc-version" value="2.1.6-6fdc9deea29"/>
      <nvpair id="cib-bootstrap-options-cluster-infrastructure" name="cluster-infrastructure" value="corosync"/>
      <nvpair id="cib-bootstrap-options-cluster-name" name="cluster-name" value="dios-ha-qualification"/>
      <nvpair id="cib-bootstrap-options-last-lrm-refresh" name="last-lrm-refresh" value="1795701606"/>
      <nvpair id="cib-bootstrap-options-cluster-recheck-interval" name="cluster-recheck-interval" value="15s"/>
    </cluster_property_set>
  </crm_config>
  <nodes>
    <node id="1" uname="control-a"/>
    <node id="2" uname="control-b"/>
    <node id="3" uname="control-c"/>
  </nodes>
  <resources>
    <primitive id="dios-fence" class="stonith" type="fence_virsh">
      <instance_attributes id="dios-fence-parameters">
        <nvpair id="fence-ip" name="ipaddr" value="10.203.53.1"/>
        <nvpair id="fence-login" name="login" value="dios-ha-fence"/>
        <nvpair id="fence-identity" name="identity_file" value="/etc/dios-ha/fence-key"/>
        <nvpair id="fence-host-check" name="pcmk_host_check" value="static-list"/>
        <nvpair id="fence-host-list" name="pcmk_host_list" value="control-a control-b control-c"/>
        <nvpair id="fence-host-map" name="pcmk_host_map" value="control-a:dios-ha-control-a;control-b:dios-ha-control-b;control-c:dios-ha-control-c"/>
        <nvpair id="fence-port" name="ipport" value="2222"/>
      </instance_attributes>
      <operations>
        <op id="dios-fence-monitor" name="monitor" interval="60s" timeout="30s"/>
      </operations>
      <meta_attributes id="dios-fence-meta_attributes">
        <nvpair id="dios-fence-meta_attributes-failure-timeout" name="failure-timeout" value="180s"/>
      </meta_attributes>
    </primitive>
    <group id="dios-control">
      <primitive id="dios-volume" class="ocf" provider="heartbeat" type="Filesystem">
        <instance_attributes id="dios-volume-parameters">
          <nvpair id="volume-device" name="device" value="/dev/vdb"/>
          <nvpair id="volume-directory" name="directory" value="/srv/dios-ha"/>
          <nvpair id="volume-fstype" name="fstype" value="ext4"/>
        </instance_attributes>
        <meta_attributes id="dios-volume-safety">
          <nvpair id="dios-volume-requires" name="requires" value="fencing"/>
        </meta_attributes>
        <operations>
          <op id="dios-volume-start" name="start" interval="0" timeout="60s"/>
          <op id="dios-volume-stop" name="stop" interval="0" timeout="60s" on-fail="fence"/>
          <op id="dios-volume-monitor" name="monitor" interval="20s" timeout="40s"/>
        </operations>
      </primitive>
      <primitive id="dios-service" class="systemd" type="dios-control">
        <meta_attributes id="dios-service-safety">
          <nvpair id="dios-service-requires" name="requires" value="fencing"/>
        </meta_attributes>
        <operations>
          <op id="dios-service-start" name="start" interval="0" timeout="120s"/>
          <op id="dios-service-stop" name="stop" interval="0" timeout="120s" on-fail="fence"/>
          <op id="dios-service-monitor" name="monitor" interval="10s" timeout="20s"/>
        </operations>
      </primitive>
      <primitive id="dios-address" class="ocf" provider="heartbeat" type="IPaddr2">
        <instance_attributes id="dios-address-parameters">
          <nvpair id="dios-ip" name="ip" value="10.203.53.50"/>
          <nvpair id="dios-netmask" name="cidr_netmask" value="24"/>
        </instance_attributes>
        <operations>
          <op id="dios-address-monitor" name="monitor" interval="10s" timeout="20s"/>
          <op id="dios-address-stop" name="stop" interval="0" timeout="30s" on-fail="fence"/>
        </operations>
      </primitive>
    </group>
  </resources>
  <constraints>
    <rsc_location id="control-a-allowed" rsc="dios-control" node="control-a" score="100"/>
    <rsc_location id="control-b-allowed" rsc="dios-control" node="control-b" score="0"/>
    <rsc_location id="control-c-allowed" rsc="dios-control" node="control-c" score="0"/>
    <rsc_location id="fence-a-allowed" rsc="dios-fence" node="control-a" score="0"/>
    <rsc_location id="fence-b-allowed" rsc="dios-fence" node="control-b" score="0"/>
    <rsc_location id="fence-c-allowed" rsc="dios-fence" node="control-c" score="0"/>
  </constraints>
  <rsc_defaults>
    <meta_attributes id="dios-resource-defaults">
      <nvpair id="dios-stickiness" name="resource-stickiness" value="200"/>
      <nvpair id="dios-migration-threshold" name="migration-threshold" value="1"/>
    </meta_attributes>
  </rsc_defaults>
</configuration>
