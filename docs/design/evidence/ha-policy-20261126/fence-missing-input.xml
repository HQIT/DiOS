          <operations>
            <op id="dios-address-monitor" name="monitor" interval="10s" timeout="20s" />
            <op id="dios-address-stop" name="stop" interval="0" timeout="30s" on-fail="fence" />
          </operations>
        </primitive>
      </group>
    </resources>
