{
  "id": "cursor-inline-review",
  "bridge": "jsonl-v1",
  "console": {
    "enabled": false,
    "input_kind": "inline-static-review",
    "name": "Cursor · 静态评审",
    "implementation": "Cursor ACP v1",
    "description": "固定样例代码评审，报告待人工复核",
    "synthetic": false,
    "input_catalog": "/absolute/operator/review-inputs.json"
  },
  "launch": {
    "image": "dios-cursor-acp:local",
    "command": [
      "python",
      "-m",
      "app.apps.inline_review",
      "--config",
      "/opt/dios/acp.json"
    ],
    "network": "dios-model-egress",
    "environment": {},
    "mounts": [
      {
        "source": "/absolute/operator/acp.json",
        "target": "/opt/dios/acp.json",
        "read_only": true
      }
    ],
    "memory_bytes": 1073741824,
    "cpu_count": 1,
    "pids_limit": 64,
    "read_only_root": true
  },
  "governance": {
    "mode": "e2ag"
  },
  "secrets": [
    {
      "ref": "model/cursor",
      "version": "v1",
      "target": "/run/secrets/cursor_api_key"
    }
  ]
}
