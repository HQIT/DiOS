{
  "id": "cursor-governed-tools",
  "bridge": "jsonl-v1",
  "console": {
    "enabled": false,
    "input_kind": "inline-static-review",
    "name": "Cursor · 受控工具评审",
    "implementation": "Cursor ACP v1",
    "description": "固定样例、E2AG 工具审批与证据报告；部署时固定镜像并完成环境验证",
    "synthetic": false,
    "input_catalog": "/absolute/operator/review-inputs.json"
  },
  "launch": {
    "image": "dios-cursor-acp:local",
    "command": [
      "python",
      "-m",
      "dios_review.cursor",
      "--config",
      "/opt/dios/acp.json",
      "--required-tool",
      "repository_search"
    ],
    "network": "dios-controlled-workloads",
    "environment": {
      "HOME": "/tmp",
      "AGENT_CLI_CREDENTIAL_STORE": "memory",
      "HTTP_PROXY": "http://model-egress:3128",
      "HTTPS_PROXY": "http://model-egress:3128",
      "NODE_USE_ENV_PROXY": "1",
      "NO_PROXY": ""
    },
    "mounts": [
      {
        "source": "/absolute/operator/acp.json",
        "target": "/opt/dios/acp.json",
        "read_only": true
      },
      {
        "source": "/absolute/operator/cursor-cli-permissions.json",
        "target": "/work/.cursor/cli.json",
        "read_only": true
      }
    ],
    "memory_bytes": 1073741824,
    "cpu_count": 1,
    "pids_limit": 64,
    "read_only_root": true
  },
  "governance": {
    "mode": "e2ag"
  },
  "secrets": [
    {
      "ref": "model/cursor",
      "version": "v1",
      "target": "/run/secrets/cursor_api_key"
    }
  ],
  "tool_channel": {
    "tools": {
      "repository_search": "repository-search"
    },
    "acp_names": {
      "mcp__dios__repository_search": "repository_search"
    },
    "worker_secret_refs": [
      "model/cursor"
    ]
  },
  "recovery": {
    "resource": "model-endpoint:cursor-account-ref",
    "replay_safe": false,
    "max_attempts": 1,
    "base_delay": 15,
    "max_delay": 300,
    "quota_delay": 900,
    "accept_complete_on_error": true
  }
}
