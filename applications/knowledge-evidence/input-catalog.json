{
  "version": 1,
  "dynamic_inputs": true,
  "requires_e2ag": true,
  "schema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "filename": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "source": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "task_kind": {
        "const": "knowledge-evidence"
      },
      "project_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "tool": {
        "const": "knowledge_search"
      },
      "sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "required": [
      "id",
      "name",
      "filename",
      "source",
      "task_kind",
      "project_id",
      "query",
      "tool",
      "sha256"
    ],
    "additionalProperties": false
  },
  "inputs": [],
  "result_schema": {
    "type": "object",
    "required": [
      "summary",
      "evidence",
      "citations",
      "application_version",
      "review_status"
    ],
    "properties": {
      "citations": {
        "type": "array",
        "minItems": 1
      },
      "application_version": {
        "type": "string"
      },
      "review_status": {
        "const": "pending_review"
      }
    }
  }
}
