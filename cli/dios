#!/usr/bin/env python3
"""DiOS 管理 CLI（Hybrid, human-friendly）：
- 人类用户优先：高层子命令（config / agent / registry / resources）
- 低层 request 仅保留给自动化（隐藏）
- 高风险操作要求 HIL 二次确认
- 记录本地审计日志
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import secrets
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any


CLI_HOME = Path(os.environ.get("DIOS_CLI_HOME", "~/.dios-cli")).expanduser()
PROFILE_PATH = CLI_HOME / "profile.json"
PENDING_PATH = CLI_HOME / "pending_actions.json"
AUDIT_PATH = CLI_HOME / "audit.log"
DEFAULT_BASE_URL = os.environ.get("DIOS_API", "http://localhost:8080")
HIL_TTL_SECONDS = 600


def _ensure_home() -> None:
    CLI_HOME.mkdir(parents=True, exist_ok=True)


def _load_json(path: Path, default: Any) -> Any:
    if not path.exists():
        return default
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return default


def _save_json(path: Path, data: Any) -> None:
    _ensure_home()
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")


def _get_base_url() -> str:
    profile = _load_json(PROFILE_PATH, {})
    return str(profile.get("base_url") or DEFAULT_BASE_URL).rstrip("/")


def _actor() -> str:
    return os.environ.get("USER") or os.environ.get("USERNAME") or "unknown"


def _append_audit(record: dict[str, Any]) -> None:
    _ensure_home()
    line = json.dumps(record, ensure_ascii=False)
    with AUDIT_PATH.open("a", encoding="utf-8") as f:
        f.write(line + "\n")


def _request(base_url: str, method: str, path: str, data: dict | None) -> tuple[int, str]:
    url = f"{base_url}{path}"
    body = None if data is None else json.dumps(data).encode("utf-8")
    req = urllib.request.Request(
        url=url,
        method=method.upper(),
        data=body,
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req) as resp:
            text = resp.read().decode("utf-8", errors="replace")
            return resp.status, text
    except urllib.error.HTTPError as e:
        text = e.read().decode("utf-8", errors="replace")
        return e.code, text


def _request_json(base_url: str, method: str, path: str, data: dict | None) -> tuple[int, Any]:
    status, text = _request(base_url, method, path, data)
    try:
        return status, json.loads(text) if text else None
    except Exception:
        return status, text


def _is_high_risk(method: str, path: str) -> bool:
    m = method.upper()
    p = path.strip()
    if m == "DELETE":
        return True
    if m in {"PUT", "PATCH"} and p.startswith("/api/os/"):
        return True
    if m == "POST" and (
        p.startswith("/api/os/models")
        or p.startswith("/api/os/mcp-servers")
        or p.startswith("/api/os/skills")
        or p.startswith("/api/os/agents")
    ):
        return True
    return False


def _is_allowed_path(path: str) -> bool:
    p = path.strip()
    allowed_prefixes = (
        "/api/os/agents",
        "/api/os/subscriptions",
        "/api/os/connectors",
        "/api/os/models",
        "/api/os/mcp-servers",
        "/api/os/skills",
        "/api/os/events",
    )
    return any(p.startswith(prefix) for prefix in allowed_prefixes)


def _payload_digest(method: str, path: str, data: dict | None) -> str:
    raw = json.dumps({"m": method.upper(), "p": path, "d": data or {}}, sort_keys=True)
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()


def _create_pending(method: str, path: str, data: dict | None) -> str:
    token = secrets.token_urlsafe(16)
    items = _load_json(PENDING_PATH, [])
    now = dt.datetime.now(dt.timezone.utc)
    expires = now + dt.timedelta(seconds=HIL_TTL_SECONDS)
    items = [x for x in items if x.get("expires_at", "") > now.isoformat()]
    items.append(
        {
            "token": token,
            "digest": _payload_digest(method, path, data),
            "method": method.upper(),
            "path": path,
            "data": data or {},
            "created_at": now.isoformat(),
            "expires_at": expires.isoformat(),
            "actor": _actor(),
        }
    )
    _save_json(PENDING_PATH, items)
    return token


def _verify_pending(confirm: str, method: str, path: str, data: dict | None) -> bool:
    now = dt.datetime.now(dt.timezone.utc).isoformat()
    digest = _payload_digest(method, path, data)
    items = _load_json(PENDING_PATH, [])
    kept = []
    matched = False
    for x in items:
        if x.get("expires_at", "") <= now:
            continue
        if x.get("token") == confirm and x.get("digest") == digest:
            matched = True
            continue
        kept.append(x)
    _save_json(PENDING_PATH, kept)
    return matched


def _consume_pending(confirm: str) -> dict[str, Any] | None:
    now = dt.datetime.now(dt.timezone.utc).isoformat()
    items = _load_json(PENDING_PATH, [])
    kept = []
    matched: dict[str, Any] | None = None
    for x in items:
        if x.get("expires_at", "") <= now:
            continue
        if x.get("token") == confirm and matched is None:
            matched = x
            continue
        kept.append(x)
    _save_json(PENDING_PATH, kept)
    return matched


def cmd_profile(args: argparse.Namespace) -> int:
    profile = _load_json(PROFILE_PATH, {})
    if args.set_base_url:
        profile["base_url"] = args.set_base_url.rstrip("/")
        _save_json(PROFILE_PATH, profile)
        print(json.dumps({"ok": True, "base_url": profile["base_url"]}, ensure_ascii=False))
        return 0
    print(json.dumps(profile or {"base_url": DEFAULT_BASE_URL}, ensure_ascii=False, indent=2))
    return 0


def cmd_config_get(args: argparse.Namespace) -> int:
    profile = _load_json(PROFILE_PATH, {"base_url": DEFAULT_BASE_URL})
    key = args.key
    if key:
        print(profile.get(key, ""))
    else:
        print(json.dumps(profile, ensure_ascii=False, indent=2))
    return 0


def cmd_config_set(args: argparse.Namespace) -> int:
    profile = _load_json(PROFILE_PATH, {})
    profile[args.key] = args.value.rstrip("/") if args.key == "base_url" else args.value
    _save_json(PROFILE_PATH, profile)
    print(json.dumps({"ok": True, "key": args.key, "value": profile[args.key]}, ensure_ascii=False))
    return 0


def _resolve_agent_selector(base_url: str, selector: str) -> dict[str, Any] | None:
    status, data = _request_json(base_url, "GET", "/api/os/agents", None)
    if status < 200 or status >= 300 or not isinstance(data, list):
        return None
    for item in data:
        if item.get("id") == selector:
            return item
    for item in data:
        if item.get("name") == selector:
            return item
    return None


def _safe_print(obj: Any) -> None:
    print(json.dumps(obj, ensure_ascii=False, indent=2))


def _command_base_url(args: argparse.Namespace) -> str:
    return args.base_url.rstrip("/") if args.base_url else _get_base_url()


def _registry_limit(value: str) -> int:
    limit = int(value)
    if not 1 <= limit <= 100:
        raise argparse.ArgumentTypeError("limit must be between 1 and 100")
    return limit


def _get_and_print(args: argparse.Namespace, path: str) -> int:
    status, data = _request_json(_command_base_url(args), "GET", path, None)
    _safe_print(data)
    return 0 if 200 <= status < 300 else 1


def cmd_registry_mcp(args: argparse.Namespace) -> int:
    query = urllib.parse.urlencode({"q": args.query, "limit": args.limit})
    return _get_and_print(args, f"/api/os/mcp-registry/search?{query}")


def cmd_registry_skills(args: argparse.Namespace) -> int:
    query = urllib.parse.urlencode({"q": args.query})
    return _get_and_print(args, f"/api/os/skills/registry?{query}")


def cmd_registry_plugins(args: argparse.Namespace) -> int:
    _safe_print(
        {
            "status": "compatibility_preview",
            "registered": 0,
            "format_target": "Open Plugins",
            "install_channel": "phase_3",
            "single_machine_policy": "registration_does_not_grant_permissions",
            "components": [
                {"name": "Skills", "status": "mappable"},
                {"name": "MCP Servers", "status": "mappable"},
                {"name": "Agents", "status": "pending_adapter"},
                {"name": "Hooks / LSP", "status": "phase_3"},
            ],
        }
    )
    return 0


def cmd_resource_list(args: argparse.Namespace) -> int:
    return _get_and_print(args, args.api_path)


def cmd_skill_import(args: argparse.Namespace) -> int:
    return _perform_managed_request(
        base_url=_command_base_url(args),
        method="POST",
        path="/api/os/skills/import-git",
        data={"url": args.url},
        confirm=args.confirm,
        human_next_cmd=f'dios skill import-git "{args.url}"',
    )


def _perform_managed_request(
    *,
    base_url: str,
    method: str,
    path: str,
    data: dict | None = None,
    confirm: str | None = None,
    print_success_json: bool = True,
    human_next_cmd: str = "",
) -> int:
    if not _is_allowed_path(path):
        print("path is not in allowed management scope", file=sys.stderr)
        return 2
    high_risk = _is_high_risk(method, path)
    if high_risk and not confirm:
        token = _create_pending(method, path, data)
        out = {
            "status": "pending_hil",
            "message": "高风险操作需要二次确认",
            "method": method.upper(),
            "path": path,
            "token": token,
            "expires_in_seconds": HIL_TTL_SECONDS,
            "next_command": f"{human_next_cmd} --confirm {token}".strip(),
        }
        _safe_print(out)
        return 3
    if high_risk and confirm and not _verify_pending(confirm, method, path, data):
        print("invalid/expired confirm token or payload mismatch", file=sys.stderr)
        return 4

    status, body = _request_json(base_url, method, path, data)
    _append_audit(
        {
            "time": dt.datetime.now(dt.timezone.utc).isoformat(),
            "actor": _actor(),
            "method": method.upper(),
            "path": path,
            "data": data or {},
            "status": status,
            "high_risk": high_risk,
            "confirmed": bool(confirm),
        }
    )
    if print_success_json:
        _safe_print(body)
    return 0 if 200 <= status < 300 else 1


def cmd_agent_list(args: argparse.Namespace) -> int:
    base_url = args.base_url.rstrip("/") if args.base_url else _get_base_url()
    status, data = _request_json(base_url, "GET", "/api/os/agents", None)
    if status < 200 or status >= 300:
        _safe_print(data)
        return 1
    agents = data if isinstance(data, list) else []
    if args.mode:
        agents = [a for a in agents if a.get("mode") == args.mode]
    if args.group:
        agents = [a for a in agents if a.get("group") == args.group]
    if args.simple:
        for a in agents:
            print(f"{a.get('id')}  {a.get('name')}  mode={a.get('mode')}  group={a.get('group','')}")
        return 0
    _safe_print(agents)
    return 0


def cmd_agent_show(args: argparse.Namespace) -> int:
    base_url = args.base_url.rstrip("/") if args.base_url else _get_base_url()
    agent = _resolve_agent_selector(base_url, args.selector)
    if not agent:
        print(f"agent not found: {args.selector}", file=sys.stderr)
        return 1
    _safe_print(agent)
    return 0


def cmd_agent_set_prompt(args: argparse.Namespace) -> int:
    base_url = args.base_url.rstrip("/") if args.base_url else _get_base_url()
    agent = _resolve_agent_selector(base_url, args.selector)
    if not agent:
        print(f"agent not found: {args.selector}", file=sys.stderr)
        return 1
    if not args.text and not args.file:
        print("must provide --text or --file", file=sys.stderr)
        return 2
    prompt = args.text if args.text is not None else Path(args.file).read_text(encoding="utf-8")
    path = f"/api/os/agents/{agent['id']}"
    data = {"system_prompt": prompt}
    next_cmd = f'dios agent set-prompt "{args.selector}"'
    if args.text is not None:
        next_cmd += f' --text "{args.text}"'
    if args.file:
        next_cmd += f' --file "{args.file}"'
    return _perform_managed_request(
        base_url=base_url,
        method="PUT",
        path=path,
        data=data,
        confirm=args.confirm,
        human_next_cmd=next_cmd,
    )


def cmd_agent_set_capabilities(args: argparse.Namespace) -> int:
    base_url = args.base_url.rstrip("/") if args.base_url else _get_base_url()
    agent = _resolve_agent_selector(base_url, args.selector)
    if not agent:
        print(f"agent not found: {args.selector}", file=sys.stderr)
        return 1
    if not args.json and not args.file:
        print("must provide --json or --file", file=sys.stderr)
        return 2
    if args.json:
        capabilities = json.loads(args.json)
    else:
        capabilities = json.loads(Path(args.file).read_text(encoding="utf-8"))
    if not isinstance(capabilities, dict):
        print("capabilities must be a JSON object", file=sys.stderr)
        return 2
    path = f"/api/os/agents/{agent['id']}"
    data = {"capabilities": capabilities}
    next_cmd = f'dios agent set-capabilities "{args.selector}"'
    if args.json:
        next_cmd += f" --json '{json.dumps(capabilities, ensure_ascii=False)}'"
    if args.file:
        next_cmd += f' --file "{args.file}"'
    return _perform_managed_request(
        base_url=base_url,
        method="PUT",
        path=path,
        data=data,
        confirm=args.confirm,
        human_next_cmd=next_cmd,
    )


def cmd_agent_delete(args: argparse.Namespace) -> int:
    base_url = args.base_url.rstrip("/") if args.base_url else _get_base_url()
    agent = _resolve_agent_selector(base_url, args.selector)
    if not agent:
        print(f"agent not found: {args.selector}", file=sys.stderr)
        return 1
    path = f"/api/os/agents/{agent['id']}"
    next_cmd = f'dios agent delete "{args.selector}"'
    return _perform_managed_request(
        base_url=base_url,
        method="DELETE",
        path=path,
        data=None,
        confirm=args.confirm,
        human_next_cmd=next_cmd,
    )


def cmd_request(args: argparse.Namespace) -> int:
    base_url = args.base_url.rstrip("/") if args.base_url else _get_base_url()
    if args.confirm_token:
        pending = _consume_pending(args.confirm_token)
        if not pending:
            print("invalid/expired confirm token", file=sys.stderr)
            return 4
        method = str(pending.get("method") or "").upper()
        path = str(pending.get("path") or "")
        data = pending.get("data") or {}
        if not method or not path:
            print("pending action is invalid", file=sys.stderr)
            return 4
    else:
        method = (args.method or "").upper()
        path = args.path or ""
        data = None
        if args.data:
            try:
                data = json.loads(args.data)
            except Exception:
                print("invalid --data json", file=sys.stderr)
                return 2

    if not _is_allowed_path(path):
        print("path is not in allowed management scope", file=sys.stderr)
        return 2

    high_risk = _is_high_risk(method, path)
    if high_risk and not args.confirm and not args.confirm_token:
        token = _create_pending(method, path, data)
        print(
            json.dumps(
                {
                    "status": "pending_hil",
                    "message": "high-risk action requires HIL confirmation",
                    "method": method,
                    "path": path,
                    "token": token,
                    "confirm_token": token,
                    "expires_in_seconds": HIL_TTL_SECONDS,
                    "next_command": f'dios request --method {method} --path "{path}"'
                    + (f" --data '{json.dumps(data, ensure_ascii=False)}'" if data is not None else "")
                    + f" --confirm {token}",
                    "next_confirm_command": f"dios request --confirm-token {token}",
                },
                ensure_ascii=False,
                indent=2,
            )
        )
        return 3

    if high_risk and args.confirm and not _verify_pending(args.confirm, method, path, data):
        print("invalid/expired confirm token or payload mismatch", file=sys.stderr)
        return 4

    status, text = _request(base_url, method, path, data)
    _append_audit(
        {
            "time": dt.datetime.now(dt.timezone.utc).isoformat(),
            "actor": _actor(),
            "method": method,
            "path": path,
            "data": data or {},
            "status": status,
            "high_risk": high_risk,
            "confirmed": bool(args.confirm),
            "confirmed_by_token_only": bool(args.confirm_token),
        }
    )
    print(text)
    return 0 if 200 <= status < 300 else 1


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="dios", description="DiOS management CLI")
    sub = p.add_subparsers(dest="cmd", required=True)

    p_profile = sub.add_parser("profile", help="get/set local cli profile (legacy)")
    p_profile.add_argument("--set-base-url", help="set default DiOS API base url")
    p_profile.set_defaults(func=cmd_profile)

    sub.add_parser("runtime", help="local durable runtime administration; runtime --help")
    sub.add_parser("managed-history", help="export, verify and import compatibility history; managed-history --help")

    p_config = sub.add_parser("config", help="manage cli config (openclaw style)")
    sub_config = p_config.add_subparsers(dest="config_cmd", required=True)
    p_cfg_get = sub_config.add_parser("get", help="get config value")
    p_cfg_get.add_argument("key", nargs="?", default="", help="config key, e.g. base_url")
    p_cfg_get.set_defaults(func=cmd_config_get)
    p_cfg_set = sub_config.add_parser("set", help="set config value")
    p_cfg_set.add_argument("key", help="config key")
    p_cfg_set.add_argument("value", help="config value")
    p_cfg_set.set_defaults(func=cmd_config_set)

    p_agent = sub.add_parser("agent", help="manage agents")
    sub_agent = p_agent.add_subparsers(dest="agent_cmd", required=True)
    p_agent_list = sub_agent.add_parser("list", help="list agents")
    p_agent_list.add_argument("--mode", help="filter by mode")
    p_agent_list.add_argument("--group", help="filter by group")
    p_agent_list.add_argument("--simple", action="store_true", help="simple line output")
    p_agent_list.add_argument("--base-url", help="override base url for this command")
    p_agent_list.set_defaults(func=cmd_agent_list)

    p_agent_show = sub_agent.add_parser("show", help="show agent by id or name")
    p_agent_show.add_argument("selector", help="agent id or name")
    p_agent_show.add_argument("--base-url", help="override base url for this command")
    p_agent_show.set_defaults(func=cmd_agent_show)

    p_set_prompt = sub_agent.add_parser("set-prompt", help="set system prompt for agent")
    p_set_prompt.add_argument("selector", help="agent id or name")
    p_set_prompt.add_argument("--text", help="prompt text")
    p_set_prompt.add_argument("--file", help="read prompt from file")
    p_set_prompt.add_argument("--confirm", help="HIL confirm token")
    p_set_prompt.add_argument("--base-url", help="override base url for this command")
    p_set_prompt.set_defaults(func=cmd_agent_set_prompt)

    p_set_cap = sub_agent.add_parser("set-capabilities", help="set capabilities JSON for agent")
    p_set_cap.add_argument("selector", help="agent id or name")
    p_set_cap.add_argument("--json", help="capabilities JSON string")
    p_set_cap.add_argument("--file", help="capabilities JSON file")
    p_set_cap.add_argument("--confirm", help="HIL confirm token")
    p_set_cap.add_argument("--base-url", help="override base url for this command")
    p_set_cap.set_defaults(func=cmd_agent_set_capabilities)

    p_agent_del = sub_agent.add_parser("delete", help="delete agent (high-risk)")
    p_agent_del.add_argument("selector", help="agent id or name")
    p_agent_del.add_argument("--confirm", help="HIL confirm token")
    p_agent_del.add_argument("--base-url", help="override base url for this command")
    p_agent_del.set_defaults(func=cmd_agent_delete)

    sub.add_parser("task", help="submit and track tasks, preview and download results (dios task --help)")

    p_registry = sub.add_parser("registry", help="discover MCP, Skill, and Plugin capabilities")
    sub_registry = p_registry.add_subparsers(dest="registry_cmd", required=True)
    p_registry_mcp = sub_registry.add_parser("mcp", help="search the Official MCP Registry")
    p_registry_mcp.add_argument("query", nargs="?", default="", help="search query")
    p_registry_mcp.add_argument("--limit", type=_registry_limit, default=20)
    p_registry_mcp.add_argument("--base-url", help="override base url for this command")
    p_registry_mcp.set_defaults(func=cmd_registry_mcp)
    p_registry_skills = sub_registry.add_parser("skills", help="search the DiOS curated Skill registry")
    p_registry_skills.add_argument("query", nargs="?", default="", help="search query")
    p_registry_skills.add_argument("--base-url", help="override base url for this command")
    p_registry_skills.set_defaults(func=cmd_registry_skills)
    p_registry_plugins = sub_registry.add_parser("plugins", help="show Plugin compatibility status")
    p_registry_plugins.set_defaults(func=cmd_registry_plugins)

    for command, help_text, api_path in (
        ("connector", "inspect Connector capabilities", "/api/os/connectors"),
        ("mcp", "inspect registered MCP Servers", "/api/os/mcp-servers"),
        ("skill", "inspect and import Skills", "/api/os/skills"),
    ):
        resource = sub.add_parser(command, help=help_text)
        resource_sub = resource.add_subparsers(dest=f"{command}_cmd", required=True)
        resource_list = resource_sub.add_parser("list", help=f"list registered {command} resources")
        resource_list.add_argument("--base-url", help="override base url for this command")
        resource_list.set_defaults(func=cmd_resource_list, api_path=api_path)
        if command == "connector":
            resource_types = resource_sub.add_parser("types", help="list installable Connector manifests")
            resource_types.add_argument("--base-url", help="override base url for this command")
            resource_types.set_defaults(func=cmd_resource_list, api_path="/api/os/connectors/types")
        if command == "skill":
            resource_import = resource_sub.add_parser("import-git", help="validate and import one Agent Skill")
            resource_import.add_argument("url", help="Git repository or GitHub tree URL containing SKILL.md")
            resource_import.add_argument("--confirm", help="HIL confirm token")
            resource_import.add_argument("--base-url", help="override base url for this command")
            resource_import.set_defaults(func=cmd_skill_import)

    return p


def build_request_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="dios request", description="internal low-level request command")
    p.add_argument("--method", help="HTTP method")
    p.add_argument("--path", help="API path, e.g. /api/os/agents")
    p.add_argument("--data", help="JSON request body")
    p.add_argument("--confirm", help="HIL confirm token for high-risk actions")
    p.add_argument("--confirm-token", help="confirm and execute pending action by token only")
    p.add_argument("--base-url", help="override base url for this request")
    return p


def cmd_task(args) -> int:
    """HTTP task commands share the Console's operator, scope and idempotency contract."""
    base_url = (args.base_url or _get_base_url()).rstrip("/")
    token = os.environ.get("DIOS_ACCESS_TOKEN", "")
    if not token:
        print("DIOS_ACCESS_TOKEN is required for task commands", file=sys.stderr)
        return 2
    method, data, suffix = "GET", None, ""
    command = args.task_command
    quote = lambda value: urllib.parse.quote(value, safe="")
    if command in {"profiles", "samples", "identity"}: suffix = "/" + command
    elif command == "list":
        suffix = "/runs?" + urllib.parse.urlencode({k:v for k,v in {"limit":args.limit,"cursor":args.cursor}.items() if v is not None})
    elif command == "submit":
        method, suffix = "POST", "/runs"
        data = dict(profile_id=args.profile, goal=args.goal, idempotency_key=args.key)
        if args.input_file:
            try:
                with open(args.input_file, 'rb') as source: raw=source.read(12289)
                if len(raw)>12288: raise ValueError()
                payload=json.loads(raw.decode('utf-8'))
                if not isinstance(payload,dict): raise ValueError()
            except (OSError,ValueError,UnicodeError):
                print(json.dumps({'error':'INVALID_WORK_INPUT'}));return 2
            data['input_payload']=payload
        else:data['sample_id']=args.sample
    elif command == "show": suffix = "/runs/" + quote(args.run_id)
    elif command in {"cancel","revoke"}:
        method, suffix = "POST", "/runs/" + quote(args.run_id) + "/" + command
        data = dict(expected_version=args.revision)
    elif command in {"preview", "download"}:
        suffix = "/runs/" + quote(args.run_id) + "/artifacts/" + quote(args.artifact_id) + "/" + command
        if command == "download": suffix += "?format=" + args.format
    elif command.startswith("tool-"):
        suffix="/runs/"+quote(args.run_id)+"/tools"
        if command=="tool-request":
            method="POST"
            try:
                arguments=json.loads(Path(args.arguments_file).read_text(encoding="utf-8"))
            except (OSError,ValueError):
                print("Invalid arguments JSON file",file=sys.stderr);return 2
            data=dict(attempt_id=args.attempt,session_id=args.session,tool_id=args.tool,arguments=arguments,idempotency_key=args.key)
        elif command!="tool-list":
            suffix+="/"+quote(args.invocation_id)
            if command!="tool-show":
                method="POST";suffix+="/"+("receipt-recover" if command=="tool-recover" else command.removeprefix("tool-"))
                data=dict(expected_version=args.revision)
                if command=="tool-approval":data.update(decision=args.decision,reason=args.reason)
    headers={"Content-Type":"application/json","X-DiOS-Access-Token":token}
    if command=="tool-approval":
        approver=os.environ.get("DIOS_APPROVER_TOKEN","")
        if not approver:
            print("DIOS_APPROVER_TOKEN is required",file=sys.stderr);return 2
        headers["X-DiOS-Approver-Token"]=approver
    request = urllib.request.Request(base_url + "/api/os/runtime" + suffix, method=method,
        data=None if data is None else json.dumps(data,ensure_ascii=False).encode(),
        headers=headers)
    try:
        with urllib.request.urlopen(request,timeout=100 if command=="tool-dispatch" else 30) as response:
            if command == "download":
                # Exclusive create protects existing reports; remove only our partial file.
                destination=Path(args.output)
                with destination.open("xb") as out:
                    try:
                        while chunk:=response.read(65536): out.write(chunk)
                    except BaseException:
                        out.close();destination.unlink(missing_ok=True);raise
                print(json.dumps({"saved":str(destination.resolve())},ensure_ascii=False))
            else:
                print(response.read().decode("utf-8"))
        return 0
    except urllib.error.HTTPError as exc:
        try:detail=json.loads(exc.read().decode()).get("detail","REQUEST_FAILED")
        except (ValueError,UnicodeError):detail="REQUEST_FAILED"
        print(json.dumps({"status":exc.code,"error":detail},ensure_ascii=False));return 2
    except (OSError,UnicodeError):
        print(json.dumps({"error":"TASK_REQUEST_OR_OUTPUT_FAILED"}));return 1


def task_parser():
    p=argparse.ArgumentParser(prog="dios task",description="Submit, track and download durable operator tasks")
    commands=p.add_subparsers(dest="task_command",required=True)
    for name in ("identity","profiles","samples","list","submit","show","cancel","revoke","preview","download","tool-list","tool-request","tool-show","tool-approval","tool-dispatch","tool-reconcile","tool-recover"):
        c=commands.add_parser(name);c.add_argument("--base-url")
        if name=="list":c.add_argument("--limit",type=int,default=30);c.add_argument("--cursor")
        if name=="submit":
            c.add_argument("--profile",required=True)
            source=c.add_mutually_exclusive_group(required=True)
            source.add_argument("--sample");source.add_argument("--input-file",help="JSON input validated against the registered application schema")
            c.add_argument("--goal",required=True);c.add_argument("--key",required=True,help="reuse this key when retrying the same submission")
        if name in {"show","cancel","revoke","preview","download"}:c.add_argument("run_id")
        if name in {"cancel","revoke"}:c.add_argument("--revision",required=True,type=int)
        if name in {"preview","download"}:c.add_argument("artifact_id")
        if name.startswith("tool-"):
            c.add_argument("run_id")
            if name=="tool-request":
                for flag in ("attempt","session","tool","arguments-file","key"):c.add_argument("--"+flag,required=True)
            elif name!="tool-list":
                c.add_argument("invocation_id")
                if name!="tool-show":c.add_argument("--revision",required=True,type=int)
                if name=="tool-approval":
                    c.add_argument("--decision",choices=["approved","denied"],required=True)
                    c.add_argument("--reason",default="")
        if name=="download":
            c.add_argument("--format",choices=["raw","markdown"],default="raw")
            c.add_argument("--output",required=True)
    return p


def cmd_runtime(args, module="app.runtime.cli") -> int:
    import subprocess
    backend = Path(__file__).resolve().parents[1] / "backend"
    python = backend / ".venv" / ("Scripts/python.exe" if os.name == "nt" else "bin/python")
    if not python.exists():
        print("Runtime CLI requires backend/.venv and backend/requirements.txt", file=sys.stderr)
        return 2
    env = dict(os.environ, PYTHONPATH=str(backend))
    return subprocess.run([str(python), "-m", module, *args], env=env).returncode


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "task":
        return cmd_task(task_parser().parse_args(sys.argv[2:]))
    if len(sys.argv) > 1 and sys.argv[1] == "runtime":
        return cmd_runtime(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "managed-history":
        return cmd_runtime(sys.argv[2:], "app.services.managed_history")
    # 低层入口：仅保留给自动化/agent，不在 dios --help 暴露
    if len(sys.argv) > 1 and sys.argv[1] == "request":
        req_args = build_request_parser().parse_args(sys.argv[2:])
        return cmd_request(req_args)

    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
